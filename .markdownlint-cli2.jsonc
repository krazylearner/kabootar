{
  // Spec prose follows the style established in docs/re (long lines, compact tables).
  // Disabled rules describe that choice; the rest must stay green.
  "globs": ["**/*.md"],
  "ignores": [".agents/**", "New folder/**", "node_modules/**"],
  "config": {
    "MD013": false,
    "MD060": false,
    "MD040": false,
    "MD041": false
  }
}
