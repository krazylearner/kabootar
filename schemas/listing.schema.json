{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kabootar.dev/schemas/listing.schema.json",
  "title": "Listing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "account_id", "adapter", "side", "chain", "asset",
    "amount_inr_atomic", "rate_inr_per_usdt", "payment_methods",
    "fee_payer", "status", "created_at"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "account_id": { "type": "string", "format": "uuid" },
    "adapter": { "type": "string", "enum": ["telegram", "web", "discord", "slack"] },
    "side": { "type": "string", "enum": ["sell", "buy"] },
    "chain": { "type": "string", "enum": ["bsc", "tron"] },
    "asset": { "type": "string", "const": "USDT" },
    "amount_usdt_atomic": { "type": ["integer", "null"], "minimum": 0 },
    "amount_inr_atomic": { "type": "integer", "minimum": 1 },
    "rate_inr_per_usdt": { "type": "number", "exclusiveMinimum": 0 },
    "payment_methods": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["cdm", "ccw", "upi", "imps", "qr_cash"] }
    },
    "fee_payer": { "type": "string", "enum": ["buyer", "seller", "split"] },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "matched", "closed", "expired"]
    },
    "community_ref": { "type": ["object", "null"] },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
